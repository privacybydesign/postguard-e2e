# Copy to .env and fill in. The run:* scripts load .env automatically.

# --- Target server (sweep runs against THIS deployment) ---
# Default to staging; point at production to test the prod move.
PG_PKG_URL=https://pkg.staging.postguard.eu
PG_CRYPTIFY_URL=https://storage.staging.postguard.eu

# --- Credentials / recipients (needed to actually run the flow) ---
# PostGuard for Business API key (PG-…). Without it the harness still
# enumerates + installs each version (to test installability) but SKIPS the
# encrypt/upload flow, marking runs as "skipped_no_api_key".
PG_API_KEY=
# Citizen = exact-email recipient; Organisation = email-domain recipient.
PG_CITIZEN_EMAIL=citizen@example.com
PG_ORGANISATION_EMAIL=noreply@example.org

# --- Which versions to sweep ---
# Each accepts: "all" | "latest:N" | a comma list "1.8.0,1.9.0" | a semver
# range "^1.0.0". Start narrow (e.g. latest:5) and widen as needed.
PG_JS_VERSIONS=latest:5
PG_DOTNET_VERSIONS=latest:5
