# Copy to .env and fill in. The sweep loads .env automatically.
#
# A profile (`npm run sweep -- --profile nightly|pre-deploy`) already supplies
# the target and the support matrix. Everything below still overrides it, and
# the report records which value came from where — so an override is visible
# rather than a nightly quietly sweeping something else.

# --- Target server (sweep runs against THIS deployment) ---
# Default to staging; point at production to test the prod move. The
# `pre-deploy` profile points at the local candidate stack (stack/) instead.
PG_PKG_URL=https://pkg.staging.postguard.eu
PG_CRYPTIFY_URL=https://storage.staging.postguard.eu

# --- Credentials / recipients (needed to actually run the wire leg) ---
# PostGuard for Business API key (PG-…). Without it the harness still
# enumerates + installs each version (to test installability) but SKIPS the
# encrypt/upload flow, marking runs as "skipped_no_api_key".
PG_API_KEY=
# Citizen = exact-email recipient; Organisation = email-domain recipient.
PG_CITIZEN_EMAIL=citizen@example.com
PG_ORGANISATION_EMAIL=noreply@example.org
# Attribute type recipients are addressed with. Empty = the SDK's production
# defaults. A deployment issuing test credentials runs its PKG with the demo
# type and needs it set to match (postguard#236), e.g.
# irma-demo.sidn-pbdf.email.email — the `pre-deploy` profile does that.
PG_EMAIL_ATTRIBUTE=

# --- Which versions to sweep ---
# Each accepts: "all" | "latest:N" | "majors:N" (the newest release of each of
# the last N major lines — the support-matrix form) | a comma list
# "1.8.0,1.9.0" | a semver range "^1.0.0" | an exact version "2.0.0" (a
# prerelease "2.0.0-rc.1" works too, but only when named exactly).
PG_JS_VERSIONS=latest:5
PG_DOTNET_VERSIONS=latest:5

# --- Decrypt legs ---
# Which committed fixture set's key universe the new-stack artifact is sealed
# into (default: the newest sealable set). Only sets carrying signkey.json +
# mpk.json can be sealed into; see fixtures/README.md.
PG_DECRYPT_SET=
# Which @e4a/pg-wasm seals it — "the new stack". Default: the `current` version
# in compat/manifest.json. Set it to probe a release candidate.
PG_SEAL_WITH=
