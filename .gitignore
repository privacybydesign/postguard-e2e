node_modules/
.env
.sandbox/
report/*
!report/.gitkeep

# stray build artifacts from dotnet sandboxes (should live under .sandbox/)
bin/
obj/

# go: compiled binaries from `go build` in a main package dir
yivi-driver/yividriver
*.test

# generated dev irma-server JWT key (regenerated locally / in CI)
stack/irma/*.pem

# rust verifier build artifacts (lockfile too: pg-core is a path dep, pinning transitive versions would false-red)
fixtures-verify/target/
fixtures-verify/Cargo.lock

# fixture generator build artifacts (published pg-core writers; the lockfile IS
# committed). One directory per pinned writer: cargo keeps one copy of a crate
# per semver-compatible range, so a same-minor pin needs its own crate.
fixtures/gen/target/
fixtures/gen-0-6-4/target/
